// Oreslang-owned scalar physics kernel. Native LLVM AOT entrypoints.
// Coordinates and velocities are signed i64, in 1/256-pixel units.
// Inputs are bounded by the host's fixed-size world and verified in native tests.
// The compiler must fail closed if it cannot lower this source.
pub fnc physics_advance_axis(int position, int velocity, int lower, int upper): int {
  const next_position: int = position + velocity;
  if (next_position < lower) { return lower; } fi
  if (next_position > upper) { return upper; } fi
  return next_position;
}

pub fnc physics_reflect_axis(int position, int velocity, int lower, int upper): int {
  const next_position: int = position + velocity;
  if (next_position < lower) { return -velocity; } fi
  if (next_position > upper) { return -velocity; } fi
  return velocity;
}

pub fnc physics_gravity(int velocity, int acceleration, int terminal): int {
  const next_velocity: int = velocity + acceleration;
  if (next_velocity > terminal) { return terminal; } fi
  return next_velocity;
}


// Deterministic, bounded integer circle/circle narrowphase predicate ONLY.
//  1: strictly overlapping, 0: separated or exactly tangent,
// -1: caller supplied an out-of-domain position/radius.
// No collision response, force/impulse, broadphase or parallel tasks yet.
// Guest arithmetic is safe for *accepted* inputs: dx^2 + dy^2 is bounded
// below (245760^2 + 143360^2), far below signed i64 maximum.
pub fnc physics_discs_overlap(int ax, int ay, int ar, int bx, int by, int br): int {
  if (physics_disc_valid(ax, ay, ar) == 0) { return -1; } fi
  if (physics_disc_valid(bx, by, br) == 0) { return -1; } fi

  return physics_valid_discs_overlap(ax, ay, ar, bx, by, br);
}

fnc physics_valid_discs_overlap(int ax, int ay, int ar, int bx, int by, int br): int {
  const dx: int = ax - bx;
  const dy: int = ay - by;
  const radii: int = ar + br;
  const separation_squared: int = dx * dx + dy * dy;
  const contact_squared: int = radii * radii;
  if (separation_squared < contact_squared) { return 1; } fi
  return 0;
}

// One bounded domain check reused for each disc (six guarded exits).
fnc physics_disc_valid(int x, int y, int radius): int {
  if (radius < 1792) { return 0; } fi
  if (radius > 3328) { return 0; } fi
  if (x < radius) { return 0; } fi
  if (y < radius) { return 0; } fi
  if (x > 245760 - radius) { return 0; } fi
  if (y > 143360 - radius) { return 0; } fi
  return 1;
}

// Deterministic world initialization also belongs to the guest. The native
// adapter only stores these scalar results in preallocated render columns.
pub fnc physics_initial_radius(int index): int { return (7 + index % 7) * 256; }
pub fnc physics_initial_x(int index): int { return (36 + (index % 16) * 57) * 256; }
pub fnc physics_initial_y(int index): int {
  if (index > 15) { return physics_initial_y(index - 16) + 9216; } fi
  return 7168;
}
pub fnc physics_initial_vx(int index): int { return (index % 9 - 4) * 97; }
pub fnc physics_initial_vy(int index): int { return -(index % 11 * 51 + 75); }
